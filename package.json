{
  "name": "copa-kaleo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/shared",
    "apps/web",
    "functions"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w functions && npm run build -w apps/web",
    "build:web": "npm run build -w apps/web",
    "typecheck": "tsc -p packages/shared && tsc -p apps/web --noEmit && tsc -p functions --noEmit",
    "test": "vitest run",
    "emulators": "npm run build -w functions && node scripts/emulators.mjs",
    "emulators:save": "firebase emulators:export ./.emulator-data --project demo-copakaleo --force",
    "emulators:reset": "node -e \"require('fs').rmSync('.emulator-data',{recursive:true,force:true})\"",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "demo": "tsx scripts/demo.ts",
    "mysql:sync": "tsx scripts/mysql-sync.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.0",
    "mysql2": "^3.11.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
